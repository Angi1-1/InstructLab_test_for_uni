# --- PROYECTO: InstructLab Test for Uni  ---

# 1. BASE DE DATOS
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=opinion_intel_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 2. IA / LLM (Ollama en Hardware RTX 5090)
OLLAMA_BASE_URL=http://ollama:11434

MODEL_NAME=granite3.3:8b

EMBEDDING_MODEL_NAME=granite-embedding:278m

# 3. AJUSTES DE RENDIMIENTO (Tuning para 32GB VRAM)
# Aumentamos el contexto a 8192 tokens (4x lo normal) para leer hilos largos de Reddit enteros.
OLLAMA_NUM_CTX=8192
# Mantiene el modelo cargado en VRAM más tiempo (evita recargas lentas)
OLLAMA_KEEP_ALIVE=5m

# 4. ADQUISICIÓN DE DATOS
FIRECRAWL_API_KEY=

# 5. CONFIG
LOG_LEVEL=INFO